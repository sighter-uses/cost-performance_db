{
  // 静的アセットのみを配信する Worker。
  // Worker スクリプト(main)は不要 —— assets-only Worker では main は省略可。
  "name": "cost-performance-db",
  "compatibility_date": "2026-08-26",

  // workers.dev サブドメインで公開する。
  // 既定値も true だが、ダッシュボード側で無効化されていても
  // デプロイ時にここが真であれば再有効化されるため明示しておく。
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
